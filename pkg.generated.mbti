// Traits
pub(open) trait Abelian : Monoid {
  fn negate(Self) -> Self
}
pub impl Abelian for Int
pub impl Abelian for Int64

pub(open) trait Lattice : Compare {
  fn less_equal(Self, Self) -> Bool
  fn join(Self, Self) -> Self
  fn meet(Self, Self) -> Self
}
pub impl Lattice for Int64

pub(open) trait Monoid : Semigroup {
  fn zero() -> Self
}
pub impl Monoid for Int
pub impl Monoid for Int64

pub(open) trait Semigroup {
  fn plus(Self, Self) -> Self
  fn is_zero(Self) -> Bool
}
pub impl Semigroup for Int
pub impl Semigroup for Int64
